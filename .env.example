OPENROUTER_API_KEY=

SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ESCALATION_CHANNEL=escalacion

MONDAY_API_TOKEN=

# Requerido — persistencia real (ver plans/2026-08-18-migracion-postgresql-pgvector.md).
# Connection string interno del recurso "daniel" en Coolify (Postgres 18 + pgvector), no
# exponer con puerto público.
POSTGRES_URL=

REDIS_URL=

WEBHOOK_PORT=3300
WEBHOOK_SECRET=

# Opcionales — WebSocket de tiempo real de RedTec Realstate (métricas de infra de la
# plataforma). El bot arranca igual sin esto, solo sin esta capacidad. Falta que RedTec
# confirme la URL real (REDTEC_PLATFORM_WS_URL, hoy es un placeholder). El nombre del secreto
# ya no hay que confirmarlo antes de deployar: la guía de RedTec es inconsistente (dice
# SUPPORT_AGENT_WEBHOOK_SECRET en el texto pero REDTEC_PLATFORM_WS_SECRET en el código de
# ejemplo), así que el código acepta cualquiera de los dos nombres — cargar el que sea que
# RedTec confirme.
REDTEC_PLATFORM_WS_URL=
REDTEC_PLATFORM_WS_SECRET=
# SUPPORT_AGENT_WEBHOOK_SECRET=

# Opcionales — Agente Técnico (diagnóstico de n8n vía una instancia de Hermes Agent en un canal
# privado de Slack por cliente, ver plans/2026-08-12-agente-tecnico-n8n-spectrum.md, sección E).
# Sin esto, consultar_agente_tecnico simplemente no se ofrece y el resto del bot funciona igual.
# Correlación de la respuesta 100% por Slack (no por el webhook de arriba): el Técnico menciona
# explícitamente al bot de Daniel en el hilo cuando tiene el diagnóstico final — ver
# src/channels/slack/tech-agent-response-handler.ts. Una fila por cliente en
# src/config/tech-agents.ts (TECH_AGENTS); hoy solo Spectrum:
TECH_AGENT_SPECTRUM_CHANNEL=tecnico-spectrum
TECH_AGENT_SPECTRUM_BOT_USER_ID=

# Opcional — A.5, cada cuánto (ms) se considera que el Agente Técnico no va a responder. Si no
# se setea, agent/tech-agent-timeout.ts usa 15 minutos por default.
TECH_AGENT_TIMEOUT_MS=

# Opcionales — canal de WhatsApp vía Evolution API (self-hosted sobre Baileys), instancia
# compartida `RedtecBot` de RedTec (ver plans/2026-09-06-canal-whatsapp-evolution-api.md). Sin
# esto, el bot arranca igual, solo sin esta capacidad. La API key es la del número compartido
# de RedTec, no una por cliente — no pedirle una nueva a cada cliente.
WHATSAPP_EVOLUTION_URL=
WHATSAPP_EVOLUTION_API_KEY=
WHATSAPP_EVOLUTION_INSTANCE=RedtecBot
# JID propio del bot dentro de los grupos (punto abierto #4 del plan, sin confirmar todavía
# cómo se obtiene) — sin esto, el canal escucha pero nunca responde.
WHATSAPP_BOT_JID=
# Único grupo donde Daniel escucha y responde menciones (pedido de Fernando 2026-09-09) — en
# cualquier otro grupo nunca contesta, solo manda avisos de estado de ticket. Tiene default en
# código al grupo "RedTec Dev" ya confirmado en vivo; solo hace falta setearlo acá si ese grupo
# de prueba cambia.
WHATSAPP_INTERNAL_GROUP_JID=
