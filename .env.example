OPENROUTER_API_KEY=

SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ESCALATION_CHANNEL=escalacion

MONDAY_API_TOKEN=

MONGODB_URI=
MONGODB_DB_NAME=daniel

REDIS_URL=

WEBHOOK_PORT=3300
WEBHOOK_SECRET=

# Opcionales — WebSocket de tiempo real de RedTec Realstate (métricas de infra de la
# plataforma). El bot arranca igual sin esto, solo sin esta capacidad. Falta que RedTec
# confirme la URL real (REDTEC_PLATFORM_WS_URL, hoy es un placeholder). El nombre del secreto
# ya no hay que confirmarlo antes de deployar: la guía de RedTec es inconsistente (dice
# SUPPORT_AGENT_WEBHOOK_SECRET en el texto pero REDTEC_PLATFORM_WS_SECRET en el código de
# ejemplo), así que el código acepta cualquiera de los dos nombres — cargar el que sea que
# RedTec confirme.
REDTEC_PLATFORM_WS_URL=
REDTEC_PLATFORM_WS_SECRET=
# SUPPORT_AGENT_WEBHOOK_SECRET=

# Opcionales — Agente Técnico (diagnóstico de n8n vía un segundo agente en Slack, ver
# plans/2026-08-12-agente-tecnico-n8n-spectrum.md). Sin esto, consultar_agente_tecnico
# simplemente no se ofrece y el resto del bot funciona igual. No hay env var nueva para la
# respuesta del Agente Técnico: usa el mismo WEBHOOK_SECRET/WEBHOOK_PORT de arriba, con
# POST /webhook/internal y body {"type": "tech_agent_diagnosis", "threadTs": "...", "mensaje": "..."}.
SLACK_AGENTS_CHANNEL=agentes-ia
SLACK_TECH_AGENT_USER_ID=
TECH_AGENT_CLIENTE_SOPORTADO=
