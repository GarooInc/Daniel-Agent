OPENROUTER_API_KEY=

SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ESCALATION_CHANNEL=escalacion

MONDAY_API_TOKEN=

MONGODB_URI=
MONGODB_DB_NAME=daniel

# Migración en curso a PostgreSQL+pgvector (ver plans/2026-08-18-migracion-postgresql-pgvector.md).
# Opcional mientras convive con Mongo — el bot arranca igual sin esto. Connection string interno
# del recurso "daniel" en Coolify (Postgres 18 + pgvector), no exponer con puerto público.
POSTGRES_URL=

REDIS_URL=

WEBHOOK_PORT=3300
WEBHOOK_SECRET=

# Opcionales — WebSocket de tiempo real de RedTec Realstate (métricas de infra de la
# plataforma). El bot arranca igual sin esto, solo sin esta capacidad. Falta que RedTec
# confirme la URL real (REDTEC_PLATFORM_WS_URL, hoy es un placeholder). El nombre del secreto
# ya no hay que confirmarlo antes de deployar: la guía de RedTec es inconsistente (dice
# SUPPORT_AGENT_WEBHOOK_SECRET en el texto pero REDTEC_PLATFORM_WS_SECRET en el código de
# ejemplo), así que el código acepta cualquiera de los dos nombres — cargar el que sea que
# RedTec confirme.
REDTEC_PLATFORM_WS_URL=
REDTEC_PLATFORM_WS_SECRET=
# SUPPORT_AGENT_WEBHOOK_SECRET=

# Opcionales — Agente Técnico (diagnóstico de n8n vía una instancia de Hermes Agent en un canal
# privado de Slack por cliente, ver plans/2026-08-12-agente-tecnico-n8n-spectrum.md, sección E).
# Sin esto, consultar_agente_tecnico simplemente no se ofrece y el resto del bot funciona igual.
# Correlación de la respuesta 100% por Slack (no por el webhook de arriba): el Técnico menciona
# explícitamente al bot de Daniel en el hilo cuando tiene el diagnóstico final — ver
# src/channels/slack/tech-agent-response-handler.ts. Una fila por cliente en
# src/config/tech-agents.ts (TECH_AGENTS); hoy solo Spectrum:
TECH_AGENT_SPECTRUM_CHANNEL=tecnico-spectrum
TECH_AGENT_SPECTRUM_BOT_USER_ID=
